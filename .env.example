# Copia este archivo a .env (gitignorado) para correr el servicio en local.
# En Render se definen las mismas variables en el panel del servicio.

# Clave compartida con el backend (encabezado X-AI-Service-Key). Sin ella el servicio
# rechaza toda petición protegida. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_SERVICE_API_KEY=

# API key de Groq (console.groq.com), solo para el chat y el resumen del asistente.
GROQ_API_KEY=

# Modelo de Groq del asistente de seguridad
GROQ_MODEL=openai/gpt-oss-120b

# Endpoint de chat completions de Groq (opcional; este es el valor por defecto)
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Segundos máximos de espera por una respuesta de Groq
GROQ_TIMEOUT_SECONDS=30

# Creatividad del modelo; baja para que copie datos exactos sin variarlos
GROQ_TEMPERATURE=0.2

# Documentación interactiva en /docs; déjala en false en producción
ENABLE_API_DOCS=false

# Parametros de los detectores (opcionales; estos son los valores por defecto, los del paquete). Mismos nombres
# que en el backend: si cambias uno, ponlo igual alla.
# Desviaciones estandar desde las que una anomalia es grave (critical) y no leve (warning)
ANOMALY_CRITICAL_Z_SCORE=3.0
# Proporcion esperada de anomalias de IsolationForest (> 0 y <= 0.5) y su semilla (resultados reproducibles)
ANOMALY_CONTAMINATION=0.1
ANOMALY_RANDOM_STATE=42
# Perdida de paquetes (%) que cuenta como caida total
OUTAGE_PACKET_LOSS_THRESHOLD_PERCENT=100
# Hueco maximo (minutos) entre mediciones de una racha para afirmar un corte continuo
OUTAGE_MAX_GAP_MINUTES=5
# Desde cuantos minutos un corte es grave (critical)
OUTAGE_CRITICAL_DURATION_MINUTES=15
